{
  "model_type": "sd3.5",
  "training_method": "lora",
  "peft_type": "lora",

  "use_safetensors": true,
  "model_path": "stabilityai/stable-diffusion-3.5-medium",

  "max_steps": 50,
  "batch_size": 1,
  "gradient_accumulation_steps": 1,
  "learning_rate": 0.0001,
  "train_dtype": "bfloat16",

  "concepts": [
    {
      "path": "datasets/qwen_edit_test",
      "caption_ext": ".txt",
      "num_repeats": 10
    }
  ],

  "resolution": 1024,
  "cache_latents": true,
  "cache_text_embeddings": true,

  "lora_rank": 16,
  "lora_alpha": 16,
  "target_modules": "transformer",

  "output_dir": "output/sd35_test",
  "save_every_n_steps": 50
}
