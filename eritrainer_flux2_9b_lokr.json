{
  "model_type": "flux2",
  "training_method": "lora",
  "peft_type": "lokr",
  "base_model": "black-forest-labs/FLUX.2-klein-base-9B",

  "max_steps": 3000,
  "batch_size": 1,
  "gradient_accumulation_steps": 1,
  "learning_rate": 0.0003,
  "train_dtype": "bfloat16",

  "concepts": [
    {
      "path": "/home/alex/a_zimage/eri2",
      "caption_file_ext": ".txt",
      "num_repeats": 1
    }
  ],

  "resolution": "512",
  "cache_latents": true,
  "cache_text_embeddings": true,

  "train_device": "cuda",
  "temp_device": "cpu",

  "optimizer": {
    "optimizer": "adafactor",
    "weight_decay": 0.0
  },
  "lr_scheduler": "constant",

  "lokr": {
    "rank": 16,
    "alpha": 1.0,
    "decompose_both": false,
    "rs_lora": true
  },

  "output_dir": "/home/alex/OneTrainer/output/flux2_9b_lokr",
  "save_every": 500,
  "output_dtype": "bfloat16",

  "sample_every": 500,
  "gradient_checkpointing": "on",
  "seed": 42
}
